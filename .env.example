# Firebase Web app config — copy to .env.local and fill in from
# Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration.
#
# These values are PUBLIC by design (they ship in the client bundle). They are not
# secrets; access control is enforced entirely by firestore.rules, which opens exactly
# one document (plans/goo) and denies everything else.
#
# If every value below is left blank the app still runs — it falls back to
# localStorage-only mode and shows "local only" in the sync indicator.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The single fixed Firestore document that holds the whole plan.
# Everyone who opens the app reads and writes this exact path. No accounts, no auth.
VITE_PLAN_DOC_PATH=plans/goo
